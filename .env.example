# 应急恢复管理员，仅保留给无法使用 Logto 时直接调用管理员登录 API。
# 正常使用时由首个 Logto 登录用户自动成为管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取。
# 线上部署时填写站点根地址，例如：https://your-domain.example.com
# PUBLIC_BASE_URL=https://your-domain.example.com

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# EggAI 登录（Logto Traditional Web Application）。
# APP_PUBLIC_URL 必须与浏览器访问地址以及 Logto 回调地址的站点根地址一致。
# 本地 HTTP 使用 COOKIE_SECURE=false，生产 HTTPS 使用 true。
# APP_PUBLIC_URL=http://localhost:3000
# LOGTO_ISSUER=https://your-tenant.logto.app/oidc
# LOGTO_INTERNAL_ISSUER=
# LOGTO_CLIENT_ID=your-client-id
# LOGTO_CLIENT_SECRET=your-client-secret
# LOGTO_SCOPE=openid profile email
# SESSION_SECRET 同时用于 Logto Cookie 加密和 Next.js 到 Go 的内部身份桥接，必须保持一致且至少 32 字符。
# SESSION_SECRET=replace-with-a-random-secret
# COOKIE_SECURE=false
# EggAI 登录后自动获取 New API 生态令牌并写入本地渠道。
# NEW_API_BASE_URL=https://new-api.example.com
# NEW_API_PUBLIC_URL=https://new-api.example.com
# NEW_API_DISPLAY_NAME=EggAI
# NEW_API_LOGTO_AUDIENCE=https://new-api.example.com/api
# NEW_API_LOGTO_SCOPE=ecosystem:me ecosystem:models:read ecosystem:tokens:read ecosystem:groups:read
